{
  "schemaVersion": 1,
  "name": "Annotation token contract (test fixture)",
  "brand": {
    "yellow": {
      "hex": "#FFDC28",
      "group": "primary"
    },
    "white": {
      "hex": "#FFFFFF",
      "group": "primary"
    },
    "purple": {
      "hex": "#3017A1",
      "group": "primary"
    },
    "black": {
      "hex": "#23232D",
      "group": "primary"
    },
    "pink": {
      "hex": "#DE0093",
      "group": "secondary"
    },
    "midPurple": {
      "hex": "#5F41E5",
      "group": "secondary"
    },
    "lightPurple": {
      "hex": "#D0C6FF",
      "group": "secondary"
    },
    "green": {
      "hex": "#218C5F",
      "group": "secondary"
    },
    "blue": {
      "hex": "#0F62FE",
      "group": "secondary"
    },
    "grey1": {
      "hex": "#333333",
      "group": "gray"
    },
    "grey2": {
      "hex": "#777B86",
      "group": "gray"
    },
    "greyLight": {
      "hex": "#DFDFEC",
      "group": "gray"
    }
  },
  "roles": {
    "mark": {
      "color": "purple",
      "note": "Default mark and the main emphasis color. Purple leads when Yellow and Black would compete."
    },
    "halo": {
      "color": "white",
      "note": "Outline under every mark so it survives dark screenshot regions."
    },
    "onMark": {
      "color": "white",
      "note": "Text on Purple, Ink, Info, Do, and Dont surfaces."
    },
    "markYellow": {
      "color": "yellow",
      "note": "Marks on dark screenshot regions only. The white halo does not separate Yellow from a light background."
    },
    "onYellow": {
      "color": "purple",
      "note": "Text on Yellow marks. Purple, not Black, so Yellow never sits against Black at equal weight."
    },
    "ink": {
      "color": "black",
      "note": "Low-emphasis notes, key caps, and the dim overlay."
    },
    "info": {
      "color": "blue",
      "note": "Neutral notes."
    },
    "do": {
      "color": "green",
      "note": "Correct example. Always paired with a check marker; Green and Pink are near-identical in grayscale."
    },
    "dont": {
      "color": "pink",
      "note": "Mistaken example. Always paired with a cross marker."
    },
    "redact": {
      "color": "black",
      "note": "Opaque redaction fill."
    }
  },
  "metrics": {
    "referenceFrameWidth": 1440,
    "strokePx": 6,
    "haloStrokePx": 12,
    "haloOutlinePx": 3,
    "badgePx": {
      "S": 32,
      "M": 48,
      "L": 64
    },
    "labelPaddingPx": {
      "x": 16,
      "y": 8
    },
    "cornerRadiusPx": {
      "label": 8,
      "highlight": 8
    },
    "strokeRule": "Strokes are authored for a 1440 px wide frame. At the docs display width a stroke must still render at 2 px or more, so on a wider frame the stroke scales up by frameWidth / displayWidth.",
    "strokeThinPx": 4,
    "haloStrokeThinPx": 8
  },
  "figmaVariables": {
    "collections": [
      {
        "name": "Annotation primitives",
        "vars": [
          {
            "name": "brand/yellow",
            "type": "COLOR",
            "brand": "yellow"
          },
          {
            "name": "brand/white",
            "type": "COLOR",
            "brand": "white"
          },
          {
            "name": "brand/purple",
            "type": "COLOR",
            "brand": "purple"
          },
          {
            "name": "brand/black",
            "type": "COLOR",
            "brand": "black"
          },
          {
            "name": "brand/pink",
            "type": "COLOR",
            "brand": "pink"
          },
          {
            "name": "brand/green",
            "type": "COLOR",
            "brand": "green"
          },
          {
            "name": "brand/blue",
            "type": "COLOR",
            "brand": "blue"
          }
        ]
      },
      {
        "name": "Annotation",
        "vars": [
          {
            "name": "color/mark",
            "type": "COLOR",
